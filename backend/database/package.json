{
  "name": "@flex-thia/database",
  "private": true,
  "type": "module",
  "exports": {
    "./clients/data-api": "./src/clients/data-api.ts",
    "./clients/local": "./src/clients/local.ts",
    "./queries/drizzle-learner-vocabulary.query": "./src/queries/drizzle-learner-vocabulary.query.ts",
    "./queries/drizzle-recommendation.query": "./src/queries/drizzle-recommendation.query.ts",
    "./queries/drizzle-wordbook.query": "./src/queries/drizzle-wordbook.query.ts",
    "./repositories/drizzle-email-challenge.repository": "./src/repositories/drizzle-email-challenge.repository.ts",
    "./repositories/drizzle-readiness.probe": "./src/repositories/drizzle-readiness.probe.ts",
    "./repositories/drizzle-user.repository": "./src/repositories/drizzle-user.repository.ts",
    "./repositories/drizzle-wordbook.repository": "./src/repositories/drizzle-wordbook.repository.ts",
    "./schema/identity.schema": "./src/schema/identity.schema.ts",
    "./schema/learning.schema": "./src/schema/learning.schema.ts",
    "./schema/thai-content.schema": "./src/schema/thai-content.schema.ts",
    "./schema/vocabulary.schema": "./src/schema/vocabulary.schema.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. backend/database/src",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.local.config.ts",
    "db:migrate:local": "tsx src/commands/migrate-local.ts",
    "db:reset-seed:local": "tsx src/commands/reset-seed-local.ts",
    "db:wait:data-api": "tsx src/commands/wait-for-data-api.ts",
    "db:migrate:data-api": "tsx src/commands/migrate-data-api.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.900.0",
    "@flex-thia/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0"
  }
}
