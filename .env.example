## 로컬 개발용 값: 복사본인 .env는 Git에 올리지 않는다.
NODE_ENV=development
AUTH_MODE=fake
LOCAL_AUTO_LOGIN=true
DATABASE_MODE=local
DATABASE_URL=postgres://flex_thia:local_only_password@localhost:5432/flex_thia
AWS_REGION=ap-northeast-2
DATABASE_NAME=flex_thia
SCHOOL_EMAIL_DOMAINS=hufs.ac.kr
CUSTOM_AUTH_SECRET=local-only-cognito-custom-auth-secret
CHALLENGE_HMAC_PEPPER=local-only-email-challenge-pepper
EMAIL_LINK_CONFIRMATION_URL=http://localhost:5173/login/confirm
FROM_EMAIL=login@flex-thia.example
FAKE_LEARNER_SUB=local-learner-sub
FAKE_LEARNER_EMAIL=learner@hufs.ac.kr
ALLOWED_ORIGINS=http://localhost:5173
PORT=3000

## passwordless 고정 상한: challenge 600초, 재전송 60초, 이메일당 일 5회,
## 전체 일 500회, 최대 오답 5회다. 운영 secret과 발신 주소는 배포 환경에서 덮어쓴다.
## 운영 인프라의 로컬 diff 값은 .env.infrastructure.example을 참고한다.
## 실제 배포 값은 .env가 아니라 GitHub production environment에 등록한다.
