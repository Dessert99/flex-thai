## 로컬 개발용 값: 복사본인 .env는 Git에 올리지 않는다.
NODE_ENV=development
AUTH_MODE=fake
DATABASE_MODE=local
DATABASE_URL=postgres://flex_thia:local_only_password@localhost:5432/flex_thia
AWS_REGION=ap-northeast-2
DATABASE_NAME=flex_thia
SCHOOL_EMAIL_DOMAINS=school.ac.kr
FAKE_USER_SUB=local-admin-sub
FAKE_USER_EMAIL=admin@school.ac.kr
FAKE_PHONE_NUMBER=+821000000000
ALLOWED_ORIGINS=http://localhost:5173
PORT=3000

## 운영 배포 값: .env가 아니라 GitHub production environment에 등록한다.
# AWS_ACCOUNT_ID=123456789012
# ROOT_DOMAIN=example.com
# HOSTED_ZONE_ID=Z0123456789EXAMPLE
# ALERT_EMAIL=owner@example.com
# ALLOWED_EMAIL_DOMAINS=school.ac.kr
# MONTHLY_BUDGET_USD=30
# MEDIA_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----
# AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/flex-thia-github-deploy

## AI·TTS provider는 아직 선택하지 않았으므로 실제 키 이름도 확정하지 않는다.
# 확정 후 provider별 키는 로컬 .env와 AWS Secrets Manager에만 저장한다.
