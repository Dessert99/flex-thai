# syntax=docker/dockerfile:1

# 로컬 통합 환경이 저장소의 고정 pnpm 버전과 workspace 의존성을 그대로 사용한다.
FROM node:22-alpine AS workspace
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile

# tsc 출력의 Nest decorator metadata를 보존해 로컬 API DI를 안정화한다.
FROM workspace AS api
RUN pnpm --filter @flex-thia/api build
EXPOSE 3000
CMD ["pnpm", "--filter", "@flex-thia/api", "exec", "tsx", "dist/backend/api/src/main.js"]

# 정적 프론트와 API proxy를 하나의 테스트 origin으로 제공한다.
FROM workspace AS web-build
RUN pnpm --filter @flex-thia/web build

FROM nginx:1.27-alpine AS web
COPY docker/nginx.local.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /workspace/frontend/web/dist /usr/share/nginx/html
EXPOSE 80
