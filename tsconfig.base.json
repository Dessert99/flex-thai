{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./frontend/web/src/*"],
      "@flex-thia/config/*": ["./backend/config/src/*"],
      "@flex-thia/database/*": ["./backend/database/src/*"],
      "@flex-thia/domain/*": ["./backend/domain/src/*"],
      "@flex-thia/providers/*": ["./backend/providers/src/*"],
      "@flex-thia/contracts/*": ["./shared/contracts/src/*"]
    }
  }
}
